# CyberHack — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# --- AI Orchestrator ---
# Backend endpoint that proxies model calls. The frontend never talks to
# the model provider directly and never embeds a provider API key.
VITE_AI_GATEWAY_URL=http://localhost:8787/api/ai

# --- Search service ---
VITE_SEARCH_API_URL=http://localhost:8787/api/search

# --- Web retrieval service ---
VITE_WEB_RETRIEVAL_API_URL=http://localhost:8787/api/web

# --- Privacy Gateway (relay / Tor abstraction) ---
VITE_PRIVACY_GATEWAY_URL=http://localhost:8787/api/privacy

# --- Security engine (URL / phishing / fingerprint analysis) ---
VITE_SECURITY_API_URL=http://localhost:8787/api/security

# --- Auth ---
VITE_AUTH_API_URL=http://localhost:8787/api/auth

# --- Feature flags ---
# When true, the app runs entirely on mock services (default for local dev
# until the backend above exists). See src/services/*/index.ts.
VITE_USE_MOCK_SERVICES=true