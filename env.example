# CyberHack — environment variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# --- AI backend (server/) ---
# Base URL of the CyberHack backend's API root. The frontend appends
# /chat itself (see src/services/ai/index.ts), so this should NOT include
# /chat or /ai. The backend never sends its provider API key here — it
# only ever streams back completed response text.
# Local dev (server/ running on its default port): http://localhost:8787/api
# Production (separate Render service): https://<your-backend>.onrender.com/api
VITE_AI_GATEWAY_URL=http://localhost:8787/api

# --- Search service ---
VITE_SEARCH_API_URL=http://localhost:8787/api/search

# --- Web retrieval service ---
VITE_WEB_RETRIEVAL_API_URL=http://localhost:8787/api/web

# --- Privacy Gateway (relay / Tor abstraction) ---
VITE_PRIVACY_GATEWAY_URL=http://localhost:8787/api/privacy

# --- Security engine (URL / phishing / fingerprint analysis) ---
VITE_SECURITY_API_URL=http://localhost:8787/api/security

# --- Auth ---
VITE_AUTH_API_URL=http://localhost:8787/api/auth

# --- Feature flags ---
# Search/privacy/security/web/auth services (all still mock in this phase).
VITE_USE_MOCK_SERVICES=true

# AI chat specifically — set to "false" to call the real backend at
# VITE_AI_GATEWAY_URL above instead of the in-browser mock. Independent of
# VITE_USE_MOCK_SERVICES so chat can go live before the other services do.
VITE_USE_MOCK_AI=true