# CyberHack API — server-side environment variables.
# Copy this file to .env for local development: cp .env.example .env
# NEVER commit the real .env file. In production (Render), set these in
# the service's Environment tab instead of committing them anywhere.

# ── AI mode ──────────────────────────────────────────────────────────────
# When "true" (the default), the server returns canned streamed responses
# and never calls a real AI provider or spends API credits. Set to "false"
# to call the real provider below.
USE_MOCK_AI=true

# ── AI provider (Groq) ───────────────────────────────────────────────────
# Server-side only. Required when USE_MOCK_AI=false. Get a key at
# https://console.groq.com — this must NEVER be exposed to the browser or
# committed to git.
GROQ_API_KEY=your_server_side_groq_key_here

# Optional. Defaults to a Groq-hosted Llama model if unset. Change this in
# one place to swap models without touching any other file.
GROQ_MODEL=llama-3.3-70b-versatile

# ── Search ───────────────────────────────────────────────────────────────
# When "true" (the default), search returns canned mock results and never
# calls a real provider or spends API credits.
USE_MOCK_SEARCH=true

# Tavily (https://tavily.com) — chosen for its free tier: 1,000 API
# credits/month, no credit card required to sign up. A "basic" search (what
# CyberHack uses) costs 1 credit. Beyond the free tier, Tavily is a paid
# metered service — see https://tavily.com/#pricing for current rates.
# Free-tier terms can change; verify on their site before relying on this.
# Required when USE_MOCK_SEARCH=false.
TAVILY_API_KEY=your_server_side_tavily_key_here

# Results returned by the search provider (title/url/snippet only).
SEARCH_MAX_RESULTS=6
# Of those, how many are actually fetched + extracted for full text.
SEARCH_SOURCES_TO_FETCH=4
# Extracted characters kept per source before it reaches the model.
SEARCH_CONTEXT_CHARS_PER_SOURCE=1500
# Hard cap on total source text injected into one AI call.
SEARCH_MAX_CONTEXT_CHARS=6000
# Request-level limits for POST /api/search itself.
MAX_SEARCH_QUERY_LENGTH=400
MAX_SEARCH_RESULTS_CEILING=10

# ── Source fetching (SSRF-protected — see services/security/ssrfProtection.ts) ──
FETCH_TIMEOUT_MS=8000
FETCH_MAX_REDIRECTS=3
FETCH_MAX_BYTES=2000000

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call this API in
# production, e.g.: https://cyberhack.onrender.com
# In development, localhost:5173 is always allowed regardless of this value.
ALLOWED_ORIGINS=

# ── Rate limiting (basic MVP abuse protection, not DDoS-grade) ──────────
RATE_LIMIT_WINDOW_MS=300000
RATE_LIMIT_MAX=30

# ── Request limits ───────────────────────────────────────────────────────
MAX_MESSAGE_LENGTH=4000
MAX_MESSAGES=24

# ── Server ───────────────────────────────────────────────────────────────
# Render sets PORT automatically in production; this is only used locally.
PORT=8787